        "tool": "code_explain",
        "text": "${input}"
      }
    },
    {
      "type": "Show Result",
      "display": "Scrolling Text",
      "description": "Display explanation"
    }
  ],
  "usage": "Copy code, Share → 'Code Explainer'"
}
