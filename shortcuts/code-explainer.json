{
  "name": "Code Explainer",
  "description": "Explain code snippets in plain English",
  "icon": "🔧",
  "tool": "code_explain",
  "shareSheet": true,
  "acceptedTypes": ["Text"],
  "actions": [
    {
      "type": "Get text from Input",
      "description": "Capture code snippet"
